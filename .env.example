# --- LLM ---
LLM_PROVIDER=anthropic            # anthropic | openai
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...             # endast om LLM_PROVIDER=openai

# --- Infra (värden matchar docker-compose; ändra för lokal körning utanför Docker) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_pm
REDIS_URL=redis://redis:6379

# --- API ---
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
JWT_SECRET=byt-mig-till-en-lang-slumpmassig-strang
JWT_TTL_HOURS=24
